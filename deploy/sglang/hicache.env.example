# Required model path or Hugging Face model id.
MODEL_PATH=Qwen/Qwen3-8B

SGLANG_HOST=0.0.0.0
SGLANG_PORT=30000
TP_SIZE=1

# Use either HICACHE_SIZE_GB or HICACHE_RATIO. If size is non-empty, it wins.
HICACHE_RATIO=2
# HICACHE_SIZE_GB=32

# write_through makes the Phase 2 restore contract deterministic: KV written
# to L1 is also copied to L2 before pressure requests evict it from GPU.
HICACHE_WRITE_POLICY=write_through
HICACHE_IO_BACKEND=kernel
HICACHE_MEM_LAYOUT=layer_first

# Leave empty for CPU L2 only. Set a backend only after pinning and validating
# its backend-specific flags for the selected SGLang release.
# HICACHE_STORAGE_BACKEND=file

# Optional request/admin authentication.
# SGLANG_API_KEY=replace-me
# SGLANG_ADMIN_API_KEY=replace-me-too
